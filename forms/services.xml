<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fieldset name="section1" label="PLG_JOOAG_SHARIFF_TAB_GENERAL">
		<field name="services" type="list" label="PLG_JOOAG_SHARIFF_SERVICE">
			<option value="">PLG_JOOAG_SHARIFF_NO_SERVICE_SELECTED</option>
			<option value="Bluesky">PLG_JOOAG_SHARIFF_BLUESKY_NAME</option>
			<option value="Buffer">PLG_JOOAG_SHARIFF_BUFFER_NAME</option>
			<option value="Clipboard">PLG_JOOAG_SHARIFF_CLIPBOARD_NAME</option>
			<option value="Diaspora">PLG_JOOAG_SHARIFF_DIASPORA_NAME</option>
			<option value="Facebook">PLG_JOOAG_SHARIFF_FACEBOOK_NAME</option>
			<option value="Flipboard">PLG_JOOAG_SHARIFF_FLIPBOARD_NAME</option>
			<option value="LinkedIn">PLG_JOOAG_SHARIFF_LINKEDIN_NAME</option>
			<option value="Mail">PLG_JOOAG_SHARIFF_MAIL_NAME</option>
			<option value="Mastodon">PLG_JOOAG_SHARIFF_MASTODON_NAME</option>
			<option value="Pinterest">PLG_JOOAG_SHARIFF_PINTEREST_NAME</option>
			<option value="Print">PLG_JOOAG_SHARIFF_PRINT_NAME</option>
			<option value="Qzone">PLG_JOOAG_SHARIFF_QZONE_NAME</option>
			<option value="Reddit">PLG_JOOAG_SHARIFF_REDDIT_NAME</option>
			<option value="Telegram">PLG_JOOAG_SHARIFF_TELEGRAM_NAME</option>
			<option value="Threads">PLG_JOOAG_SHARIFF_THREADS_NAME</option>
			<option value="Threema">PLG_JOOAG_SHARIFF_THREEMA_NAME</option>
			<option value="Tumblr">PLG_JOOAG_SHARIFF_TUMBLR_NAME</option>
			<option value="Twitter">PLG_JOOAG_SHARIFF_TWITTER_NAME</option>
			<option value="Vk">PLG_JOOAG_SHARIFF_VK_NAME</option>
			<option value="Weibo">PLG_JOOAG_SHARIFF_WEIBO_NAME</option>
			<option value="Whatsapp">PLG_JOOAG_SHARIFF_WHATSAPP_NAME</option>
			<option value="Xing">PLG_JOOAG_SHARIFF_XING_NAME</option>
			<option value="Info">PLG_JOOAG_SHARIFF_INFO_NAME</option>
		</field>
	</fieldset>
	<fieldset name="section2" label="PLG_JOOAG_SHARIFF_TAB_OPTIONS">
		<field name="data-twitter-via" showon="services:Twitter" type="text" label="PLG_JOOAG_SHARIFF_TWITTER_VIA" filter="string"/>
		<field name="special_facebook_app_id" showon="services:Facebook" type="text" label="PLG_JOOAG_SHARIFF_FACEBOOK_APP_ID" description="PLG_JOOAG_SHARIFF_FACEBOOK_API_DESC" filter="string"/>
		<field name="special_facebook_app_secret" showon="services:Facebook" type="password" label="PLG_JOOAG_SHARIFF_FACEBOOK_SECRET" filter="raw" autocomplete="off"/>
		<field name="data-mail-url" showon="services:Mail" type="text" label="PLG_JOOAG_SHARIFF_MAIL_URL" description="PLG_JOOAG_SHARIFF_MAIL_DESC" filter="string" hint="mailto:"/>
		<field name="data-mail-subject" showon="services:Mail" type="text" label="PLG_JOOAG_SHARIFF_MAIL_SUBJECT" filter="string"/>
		<field name="data-mail-body" showon="services:Mail" type="text" label="PLG_JOOAG_SHARIFF_MAIL_BODY" filter="string" hint="{url}"/>
		<field name="special_data_info_display_article_id" showon="services:Info" type="number" min="0" filter="integer" label="PLG_JOOAG_SHARIFF_INFO_BUTTON_ARTICLE" description="PLG_JOOAG_SHARIFF_INFO_BUTTON_ARTICLE_DESC"/>
		<field name="special_data_info_display" showon="services:Info" type="list" default="blank" label="PLG_JOOAG_SHARIFF_INFO_DISPLAY">
			<option value="blank">PLG_JOOAG_SHARIFF_INFO_DISPLAY_BLANK</option>
			<option value="popup">PLG_JOOAG_SHARIFF_INFO_DISPLAY_POPUP</option>
			<option value="self">PLG_JOOAG_SHARIFF_INFO_DISPLAY_SELF</option>
		</field>
	</fieldset>
</form>
